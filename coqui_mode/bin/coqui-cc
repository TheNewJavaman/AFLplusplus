#!/usr/bin/env python3
"""
coqui-cc --- coqui mode compiler driver.

Compiles C/C++ sources targeting NVPTX, runs the coqui pass plugin,
links the device runtime, produces a .cubin.

Simplified from /coqui/driver/coqui: no --test/--oracle modes, no
CPU-binary emission, no --heap-size (derived at runtime).
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path

PREFIX = os.environ.get("COQUI_PREFIX", "/usr/local")
RUNTIME_BC = f"{PREFIX}/lib/coqui-cc/runtime.bc"
PASS_PLUGIN = f"{PREFIX}/lib/coqui-cc/CoquiPassPlugin.so"


def detect_arch(device: int) -> str:
    """Query nvidia-smi for the compute capability of the device."""
    try:
        out = subprocess.check_output(
            ["nvidia-smi", f"--id={device}",
             "--query-gpu=compute_cap", "--format=csv,noheader"],
            text=True)
        cap = out.strip().replace(".", "")
        return f"sm_{cap}"
    except Exception:
        return "sm_75"


def run(cmd, check=True, **kw):
    print("[coqui-cc]", " ".join(str(c) for c in cmd), file=sys.stderr)
    return subprocess.run(cmd, check=check, **kw)


def main():
    ap = argparse.ArgumentParser(description="coqui mode compiler driver")
    ap.add_argument("sources", nargs="+", help="C/C++ source files")
    ap.add_argument("-o", "--output", required=True, help="output base name")
    ap.add_argument("-arch", default=None, help="target GPU arch (e.g., sm_75)")
    ap.add_argument("--device", type=int, default=0, help="device for arch detection")
    ap.add_argument("--stack-size", type=int, default=32768,
                    help="real stack bytes per thread (default 32768)")
    ap.add_argument("--slab-pool-size", type=int, default=0,
                    help="optional shared slab pool size (0 = disabled)")
    ap.add_argument("-I", dest="includes", action="append", default=[])
    ap.add_argument("-D", dest="defines", action="append", default=[])
    ap.add_argument("--emit-ptx", action="store_true",
                    help="stop after PTX (don't run ptxas)")
    ap.add_argument("--emit-bc", action="store_true",
                    help="stop after IR transform")
    ap.add_argument("-v", action="store_true", help="verbose")
    args = ap.parse_args()

    arch = args.arch or detect_arch(args.device)
    out = Path(args.output)
    workdir = out.parent / f".{out.name}.build"
    workdir.mkdir(parents=True, exist_ok=True)

    # 1. Compile each source to .bc with NVPTX target
    bcs = []
    for src in args.sources:
        src_p = Path(src)
        bc = workdir / (src_p.stem + ".bc")
        cmd = [
            "clang", "--target=nvptx64-nvidia-cuda",
            "-O2", "-emit-llvm", "-c",
            "-g0", "-fno-stack-protector", "-fno-pic",
            "-D__COQUI_DEVICE__=1",
        ]
        for inc in args.includes:
            cmd += ["-I", inc]
        for d in args.defines:
            cmd += ["-D", d]
        cmd += [str(src_p), "-o", str(bc)]
        run(cmd)
        bcs.append(str(bc))

    # 2. llvm-link user BCs only (runtime added after prune; see step 3b).
    linked_bc = workdir / "linked.bc"
    run(["llvm-link", *bcs, "-o", str(linked_bc)])

    # 3a. Prune unreachable code: internalize everything except the user entry
    # point, then run globaldce. Strips library functions (e.g., cJSON's
    # print_value, which pulls in sprintf) that the harness never actually calls.
    # Runtime is NOT included here so the coqui pass-injected calls to runtime
    # helpers (__coqui_fuzz_tid, etc.) are not subject to premature DCE.
    pruned_bc = workdir / "pruned.bc"
    run([
        "opt", "-passes=internalize,globaldce",
        "-internalize-public-api-list=LLVMFuzzerTestOneInput",
        str(linked_bc), "-o", str(pruned_bc),
    ])

    # 3b. Re-link runtime after prune so runtime symbols survive DCE.
    #     The coqui passes inject calls to __coqui_fuzz_tid and other helpers;
    #     those definitions must be present when the pass runs (for InternalLinkage
    #     function creation) and when ptxas resolves the final PTX.
    with_runtime_bc = workdir / "with_runtime.bc"
    run(["llvm-link", str(pruned_bc), RUNTIME_BC, "-o", str(with_runtime_bc)])

    # 3c. opt with coqui pipeline
    # Forward --stack-size to the pass via -coqui-stack-size so the IR
    # layout's heap/shadow sizes track the runtime cuCtxSetLimit value.
    #
    # Chain always-inline AFTER coqui: the ASan pass INSERTS calls to
    # runtime fast-path wrappers (__coqui_asan_check_load/store_N) during
    # this phase, so the inliner must run afterward to see those new call
    # sites. Runtime fast-path wrappers carry always_inline; their outlined
    # slow-path counterparts carry noinline and remain as calls.
    transformed_bc = workdir / "transformed.bc"
    run([
        "opt", "-load-pass-plugin", PASS_PLUGIN,
        "-passes=coqui,always-inline",
        f"-coqui-stack-size={args.stack_size}",
        str(with_runtime_bc), "-o", str(transformed_bc),
    ])

    if args.emit_bc:
        print(f"[coqui-cc] BC written: {transformed_bc}")
        sys.exit(0)

    # 4. llc -> .ptx
    #
    # COQUI_LLC_OPT can override the opt level (default: llc's implicit, which
    # is -O2). On huge ASan-instrumented modules (libxml2: 211k outlined call
    # sites) llc -O2 register allocation stalls; -O1 is what coqui's driver
    # uses and completes. Scoped to env-var so normal targets stay at -O2.
    ptx_path = out.with_suffix(".ptx") if args.emit_ptx else workdir / "out.ptx"
    llc_cmd = ["llc", f"-march=nvptx64", f"-mcpu={arch}"]
    llc_opt = os.environ.get("COQUI_LLC_OPT", "")
    if llc_opt:
        llc_cmd.append(llc_opt)
    llc_cmd += [str(transformed_bc), "-o", str(ptx_path)]
    run(llc_cmd)

    if args.emit_ptx:
        sys.exit(0)

    # 5. ptxas -> .cubin.
    #
    # -O1 minimum (project constraint). ASan-instrumented PTX can push ptxas
    # to ~100 GB RSS on some targets (stb_image, libpng). coqui-cc does NOT
    # serialize ptxas internally — if you are running multiple coqui-cc
    # invocations simultaneously, the caller is responsible for sequencing
    # them (e.g., a serial for-loop). An earlier attempt to flock this call
    # broke under SIGKILL of a waiter and left the lock file held
    # indefinitely.
    #
    # COQUI_PTXAS_OFC (default unset = off) enables CUDA 13.2+ ptxas
    # --Ofast-compile, which trades runtime performance for compile speed
    # by disabling certain optimizations. Useful for huge ASan-instrumented
    # PTX (libxml2-style) where the 50-90 min ptxas run is the bottleneck.
    # Values:
    #   min — minimal impact on both compile and runtime; disables some
    #         expensive opts. Best safety-to-speed tradeoff per NVIDIA docs.
    #   mid — balance compile and runtime; disables more expensive opts.
    #   max — fastest compile; disables many opts. Expect runtime (exec/s)
    #         regression under fuzzing.
    #   0   — disabled (default, matches current behavior).
    # Only applied when explicitly set to a non-empty, non-"0" value.
    # Requires CUDA 13.2+ ptxas; coqui itself does not use this flag.
    ptxas_opt = os.environ.get("COQUI_PTXAS_OPT", "-O2")
    ptxas_ofc = os.environ.get("COQUI_PTXAS_OFC", "").strip()
    cubin = out.with_suffix(".cubin") if out.suffix else Path(str(out) + ".cubin")
    ptxas_cmd = ["ptxas", f"-arch={arch}"]
    # ptxas rejects -O<n> combined with --Ofast-compile=<level>; the OFC
    # flag replaces the opt-level entirely. Pass only one of them.
    if ptxas_ofc and ptxas_ofc != "0":
        ptxas_cmd.append(f"--Ofast-compile={ptxas_ofc}")
    else:
        ptxas_cmd.append(ptxas_opt)
    ptxas_cmd.extend([str(ptx_path), "-o", str(cubin)])
    run(ptxas_cmd)

    # 6. Write .conf sidecar
    conf = cubin.with_suffix(".conf")
    conf.write_text(
        f"stack_size={args.stack_size}\n"
        f"slab_pool_size={args.slab_pool_size}\n"
        f"arch={arch}\n"
    )

    print(f"[coqui-cc] cubin written: {cubin}")
    print(f"[coqui-cc] config: {conf}")


if __name__ == "__main__":
    main()
